  "displayCode": "141 مصيم",
  "name": "أساسيات ميكانيكا الموائع",
  "nameEn": "Basics of Fluid Mechanics",
  "creditHours": 3,
  "contactHours": 4,
  "lectureHours": 2,
  "labHours": 2,
  "trainingType": "نظري وعملي",
  "trainingMode": "تدريب حضوري",
  "level": 2,
  "prerequisite": "101 فيزي",
  "description": "يقدم هذا المقرر للمتدرب العناصر الأساسية لخواص الموائع ويتطرق إلى استاتيكا وديناميكا الموائع. كما يقدم الحسابات الخاصة بالتدفق والأنابيب والمجاري وفقدان الضغط بسبب الاحتكاك. كما يعرض المقرر القوانين الأساسية التي تحكم الموائع.",
  "generalObjective": "إعطاء المتدرب أسس ميكانيكا الموائع التي تساعده في تحليل أداء الآلات الميكانيكية التي تعمل بالموائع.",
  "objectives": {
    "knowledge": [
      "تطبيق قوانين الهيدروستاتيكا (ضغط الموائع الساكنة).",
      "تحديد الفرق بين اللزوجة الديناميكية واللزوجة الكينماتيكية.",
      "تعيين الضغط للمائع باستخدام مانومترات مختلفة.",
      "تطبيق معادلة الاستمرارية ومعادلة برنولي على نظام مفتوح.",
      "شرح معامل الاحتكاك وحساب الهبوط في الضغط في الأنابيب والمجاري الهوائية والوصلات."
    ],
    "procedural": [
      "حساب الضغط في الموائع الساكنة.",
      "إيجاد ضغط المائع باستخدام مانومترات مختلفة.",
      "حساب معدل التدفق وفرق الضغط.",
      "حساب الهبوط في الضغط في الأنابيب والمجاري الهوائية والوصلات.",
      "حساب القوى الناتجة عن ضغط المائع."
    ]
  },
  "resources": "قاعة تدريبية، مقاعد قابلة لإعادة التشكيل، حاسب آلي، جهاز عرض، عروض تقديمية، منصة إدارة تعلم (LMS)، محتوى ومواد تعليمية، مكتبة الكترونية، سبورة وأقلام ملونة.",
  "equipment": [
    "جهاز قياس الكثافة (هيدرومتر)",
    "جهاز قياس لزوجة السوائل",
    "جهاز قياس الضغط الاستاتيكي",
    "جهاز قياس الضغط الهيدروستاتيكي",
    "جهاز برنولي",
    "جهاز قياس الضغط في المواسير",
    "جهاز قياس الضغط في عناصر التوصيل"
  ],

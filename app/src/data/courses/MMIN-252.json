  "منصة تعليمية لتشخيص أعطال التروس",
  "محرك كهربائي مع مضخة ونماذج مختلفة من القارنات",
  "مقطع مضخة لإبراز موانع التسرب",
  "مجموعة متنوعة الأشكال والأنواع من موانع التسرب",
  "جهاز قياس السرعة عن بعد",
  "جهاز قياس الحرارة عن بعد",
  "صندوق حشوات غير قابلة للصدأ بأحجام مختلفة"
 ],
 "safetyInstructions": [
  "لا تبدأ العمل على أي منظومة قبل إيقافها وفصل قدرتها وتطبيق الحبس والوسم (LOTO).",
  "تأكد من تركيب أغطية الحماية على السيور والسلاسل قبل أي تشغيل تجريبي.",
  "لا تُقرّب اليد أو الملابس أو أدوات القياس من سيرٍ أو سلسلةٍ أو ترسٍ أثناء الدوران.",
  "ارتدِ نظارة واقية وقفازات مناسبة عند القطع والتنظيف وصناعة الجوانات.",
  "احذر انحباس الأصابع بين البكرات والسيور عند الشد والتركيب.",
  "استخدم أدوات شد السيور المخصصة، ولا تستعمل مفكاً أو عتلةً ارتجالية.",
  "تعامل مع مواد التنظيف والمذيبات في مكان جيد التهوية وبعيداً عن مصادر اللهب.",
  "لا توجّه شعاع جهاز المحاذاة بالليزر نحو العينين.",
  "تعامل بحذر مع حواف الجوانات والصفائح المعدنية عند القص.",
  "تخلّص من الجوانات والزيوت المستعملة في الحاويات المخصصة لها.",
  "حافظ على خلو الأرضية من الزيوت وأدوات العمل.",
  "أبلغ المدرب فوراً عن أي عطل أو تسرب أو إصابة."
 ],

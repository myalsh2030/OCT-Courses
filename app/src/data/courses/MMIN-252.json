  ],
  "procedural": [
   "أداء التطبيقات العملية على موانع التسريب بشكل صحيح.",
   "أداء التطبيقات العملية على السيور بشكل صحيح.",
   "أداء التطبيقات العملية على التروس ونواقل الحركة بشكل صحيح."
  ]
 },
 "resources": "قاعة تدريبية، مقاعد قابلة لإعادة التشكيل، حاسب آلي، جهاز عرض، عروض تقديمية، منصة إدارة تعلم (LMS)، محتوى ومواد تعليمية، مكتبة الكترونية، سبورة وأقلام ملونة.",
 "equipment": [
  "جهاز ليزر لتعديل توازي الأعمدة",

   "الإلمام بأساسيات رسم الأبعاد.",
   "الإلمام بأساسيات الإسقاط العمودي.",
   "الإلمام بأساسيات القطاعات.",
   "الإلمام بأساسيات رسم المجسمات."
  ],
  "procedural": [
   "أداء التطبيقات العملية على مقدمة في الرسم الهندسي وأدوات الرسم الهندسي بشكل صحيح.",
   "أداء التطبيقات العملية على العمليات الهندسية بشكل صحيح.",
   "أداء التطبيقات العملية على رسم الأبعاد بشكل صحيح.",
   "أداء التطبيقات العملية على الإسقاط العمودي بشكل صحيح.",
   "أداء التطبيقات العملية على القطاعات بشكل صحيح.",
   "أداء التطبيقات العملية على رسم المجسمات بشكل صحيح."
  ]

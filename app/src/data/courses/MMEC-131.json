 "resources": "قاعة تدريبية، مقاعد قابلة لإعادة التشكيل، حاسب آلي، جهاز عرض، عروض تقديمية، منصة إدارة تعلم (LMS)، محتوى ومواد تعليمية، مكتبة الكترونية، سبورة وأقلام ملونة.",
 "equipment": [
  "طاولات رسم بمساطر متحركة",
  "لوحات رسم بمقاساتها",
  "أدوات الرسم: مثلثات ومنقلة وفرجار ومساطر قياس",
  "أقلام رسم بدرجات مختلفة وأدوات محو",
  "ورق رسم بمقاسات A3 و A4",
  "نماذج مجسمات للتدريب على الإسقاط",
  "نماذج قطاعات ومقاطع مفكّكة",
  "جهاز عرض وسبورة للرسم التوضيحي"
 ],
 "safetyInstructions": [
  "تأكد من مناسبة الإضاءة والتهوية في قاعة الرسم قبل بدء العمل.",
  "تعرّف على مواقع مخارج الطوارئ وطفاية الحريق وصندوق الإسعافات الأولية.",
  "تعامل بحذر مع أدوات الرسم الحادة: الفرجار وشفرات القص والمشارط.",
  "أغلق الفرجار والأدوات الحادة عند عدم استخدامها، ولا تتركها على حافة الطاولة.",
  "ثبّت طاولة الرسم بزاوية آمنة، وتأكد من ثبات اللوحة قبل الرسم عليها.",
  "اجلس بوضعية صحيحة تدعم الظهر، وأرح عينيك فترةً قصيرة كل نصف ساعة.",
  "حافظ على ترتيب الطاولة وخلو الممرات من الحقائب والأدوات.",
  "استخدم مثبّتات الرسم (السبراي) ومواد المحو في مكان جيد التهوية.",
  "أبعد الأوراق والمواد الورقية عن مصادر الحرارة والتوصيلات الكهربائية.",
  "أعد الأدوات إلى أماكنها ونظّف الطاولة بعد الانتهاء.",
  "أبلغ المدرب فوراً عن أي أداة تالفة أو إصابة ولو بسيطة."
 ],

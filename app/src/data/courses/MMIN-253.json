  "منصة تعليمية لصيانة الرافعات الجسرية",
  "آلات لحام محمولة TIG وMIG/MAG",
  "قواطع أنابيب يدوية وكهربائية مع عدة لوالب الأنابيب",
  "توصيلات أنابيب وصمامات متنوعة (بوابة، فراشة، كروي)",
  "جهاز كشف التسرب في الأنابيب",
  "مصائد بخار بأنواعها ومقاطعها",
  "مبادلات حرارية للفك والتركيب",
  "منصة تعليمية لسخان المياه بالطاقة الشمسية"
 ],
 "safetyInstructions": [
  "لا تشغّل مرفاعاً أو معدة رفع إلا بعد التدرب عليها وبإذن المدرب.",
  "تحقق من حمولة المرفاع والسلاسل والأحزمة قبل الرفع، ولا تقف تحت الحمل أبداً.",
  "طبّق الحبس والوسم (LOTO) وتأكد من تفريغ الضغط وبرودة الخط قبل فتح أي وصلة أو صمام.",
  "عالج خطوط البخار والمكثفات على أنها ساخنة دائماً، واستخدم القفازات الحرارية.",
  "لا تفكّ براغي الفلنشة قبل التأكد من خلو الخط من الضغط والسائل.",
  "ارتدِ نظارة واقية وقفازات عند قطع الأنابيب ولولبتها وتركيبها.",
  "استخدم كمامة عند إزالة المواد العازلة، وتعامل مع أليافها بحذر.",
  "لا تشغّل غلاية أو مبادلاً إلا بحضور المدرب وبعد فحص أجهزة الأمان وصمام التنفيس.",
  "أبقِ الممرات ومخارج الطوارئ خالية من الأنابيب والعدد.",
  "استخدم سلّماً أو منصةً آمنة عند العمل المرتفع، ولا تتسلق الخطوط أو الهياكل.",
  "تخلّص من المواد المزالة والمخلفات في الحاويات المخصصة.",
  "أبلغ المدرب فوراً عن أي تسرب بخار أو ماء ساخن أو صوت غير معتاد."
 ],

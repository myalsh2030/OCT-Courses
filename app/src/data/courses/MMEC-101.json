 "prerequisite": "",
 "description": "هذا المقرر تدريبٌ عملي يؤسس المتدرب فنياً في أهم المهارات الأساسية للتخصص: قياس الأبعاد ونقلها إلى قطعة العمل، وعمليات القطع اليدوي والآلي. يتدرب فيه على الاستخدام الصحيح لأدوات القياس والعدد اليدوية، وعلى تنفيذ القطع اليدوي بالأجنة والنشر اليدوي والبرادة والتثقيب وقطع اللوالب، مع الإلمام بقواعد السلامة والأمان عند التعامل مع آلات التشغيل (المثاقب والمخارط والفرايز).",
 "generalObjective": "إكساب المتدرب المهارات الفنية التأسيسية في قياس الأبعاد وعمليات القطع اليدوي والآلي، وهي أساس الدخول في دراسة العمليات الإنتاجية المختلفة.",
 "objectives": {
  "knowledge": [
   "الإلمام بأساسيات قياس الأطوال والشنكرة ونقل الأبعاد إلى قطعة العمل.",
   "الإلمام بأساسيات القطع اليدوي بالأجنة والنشر اليدوي.",
   "الإلمام بأساسيات البرادة.",
   "الإلمام بأساسيات التثقيب وتشطيب الثقوب.",
   "الإلمام بأساسيات قطع اللوالب يدوياً.",
   "الإلمام بأساسيات التشغيل بواسطة آلات التشغيل."
  ],
  "procedural": [
   "أداء التطبيقات العملية على قياس الأطوال والشنكرة ونقل الأبعاد إلى قطعة العمل بشكل صحيح.",
   "أداء التطبيقات العملية على القطع اليدوي بالأجنة والنشر اليدوي بشكل صحيح.",
   "أداء التطبيقات العملية على البرادة بشكل صحيح.",
   "أداء التطبيقات العملية على التثقيب وتشطيب الثقوب بشكل صحيح.",
   "أداء التطبيقات العملية على قطع اللوالب يدوياً بشكل صحيح.",
   "أداء التطبيقات العملية على التشغيل بواسطة آلات التشغيل بشكل صحيح."
  ]
 },
 "resources": "قاعة تدريبية، مقاعد قابلة لإعادة التشكيل، حاسب آلي، جهاز عرض، عروض تقديمية، منصة إدارة تعلم (LMS)، محتوى ومواد تعليمية، مكتبة الكترونية، سبورة وأقلام ملونة.",
 "equipment": [
  "طاولة برادة بملحقاتها وملازم تثبيت",
  "مثقب كهربائي قائم متعدد السرعات بملحقاته",
  "زهرة استواء (سطح إسناد)",
  "طاولة طرق",
  "قدمة تحديد الارتفاعات",
  "قدمات ذات ورنية وأدوات قياس يدوية",
  "أدوات الشنكرة: شنكار وعلام وفرجار ومسطرة صلب",
  "مجموعة مبارد بأنواعها ومقابضها",
  "مناشير يدوية ونصالها",
  "أجنة (أزاميل) ومطارق",
  "عدة قطع اللوالب: لقم اللولبة وذكورها",
  "بنط تثقيب حلزونية وعدد التخويش والبرغلة"
 ],
 "safetyInstructions": [
  "ارتدِ ملابس العمل وحذاء السلامة، ولا ترتدِ ملابس فضفاضة أو ساعةً أو خاتماً عند العمل على الآلات.",
  "اربط الشعر الطويل وأزل كل ما يتدلّى قبل تشغيل المثقب أو المخرطة.",
  "لا تستخدم أي عدة أو آلة إلا بعد التدرب عليها وبإذن المدرب.",
  "افحص العدد قبل الاستعمال: مقابض المبارد سليمة، ورؤوس الأزاميل غير مُفطَّرة.",
  "ثبّت المشغولة في الملزمة قبل البرادة أو النشر أو التثقيب، ولا تمسكها بيدك.",
  "ارتدِ النظارة الواقية عند الطرق والقطع والتثقيب والجلخ.",
  "لا تُزل الرايش باليد — استخدم الفرشاة، ولا تنفخه بالفم أو بالهواء المضغوط.",
  "أزل مفتاح الظرف قبل تشغيل المثقب أو المخرطة، ولا تقس المشغولة أثناء الدوران.",
  "تعامل مع المشغولة بعد التشغيل على أنها ساخنة وحادة الحواف.",
  "وجّه المنشار والأزميل بعيداً عن يدك وعن زملائك.",
  "أعد العدد إلى أماكنها ونظّف طاولة العمل والآلة بعد الانتهاء.",
  "أبلغ المدرب فوراً عن أي إصابة أو عدة تالفة أو عطل في الآلة."
 ],
